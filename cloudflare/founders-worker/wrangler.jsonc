    "SENDFOX_APPROVED_LIST_ID": "647369",
    "SENDFOX_WEEKLY_CALL_INVITE_SENT_LIST_ID": "649190",
    "SENDFOX_WEEKLY_CALL_CONFIRMED_LIST_ID": "649191",
    "SENDFOX_PMA_SENT_LIST_ID": "647370",
    "SENDFOX_PAYMENT_LIST_ID": "647371",
    "SENDFOX_MEMBER_LIST_ID": "647372",
